# Copy this file to .env and fill what you use.

# Free Pixabay API key: https://pixabay.com/api/docs/ (better India-specific footage coverage)
PIXABAY_API_KEY=

# Free Pexels API key: https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional: if you use local Ollama for script assistance
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional YouTube API credentials (download client_secret.json from Google Cloud)
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
