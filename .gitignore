# Secrets — real credentials only ever live in GitHub Actions secrets, never in the repo.
.env
youtube/

# Local virtualenv / caches
.venv/
__pycache__/
*.pyc

# Downloaded stock footage caches — re-fetched from Pixabay/Pexels each run, no need to version.
assets/videos/pixabay/
assets/videos/pexels/

# Generated videos never need to enter git: YouTube gets them via direct API upload, Instagram
# gets them via a GitHub Release asset uploaded straight from the runner's local disk. Keeping
# rendered video out of git history entirely avoids the repo growing forever with binary blobs.
output/

# Stray local test renders sitting at the project root (not part of the structured output/ tree).
/final_video*.mp4
/test_devanagari.wav
